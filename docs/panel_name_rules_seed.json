{"panel_code":"^door_middle_(\\d+)$","display_name":"$1号玻璃门","category":"door_panel","enable":true,"match_type":"regex"}
{"panel_code":"^door_upper_(\\d+)$","display_name":"上门$1","category":"door_panel","enable":true,"match_type":"regex"}

