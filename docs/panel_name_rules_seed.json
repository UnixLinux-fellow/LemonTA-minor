// 云端 panel_name_dict 集合的模糊匹配规则种子清单。
// 用法: 每一行是一条要写入云表的记录(_id 交给云端自动生成)。
//   - match_type 缺失 或 "exact": panel_code 精确匹配 (行为不变)
//   - match_type = "regex":       panel_code 是 JS 正则字符串, display_name 是模板,
//                                 支持 $1/$2 反向引用捕获组的值。
// 匹配优先级 (panel-dict.js 内):
//   1) 精确 Map 命中
//   2) 遍历所有 regex 行(按 _id 顺序), 第一条匹配的胜出
// 无效正则的行会被 warn 且跳过, 不会阻断加载。
//
// 命名约定:
//   - 数字/编号统一放句末: "下门1", "01号抽面"
//   - L/R 左右分柜作为中文前缀: "左柜..." / "右柜..."
//   - 书柜中门是玻璃门, 中文名带"玻璃"标识
//   - 与现有精确行(side_left_panel_18 等)共存, 精确优先

// ============ 鞋柜: 门板 ============
{"panel_code":"^lower_door_(\\d+)$","display_name":"下门$1","category":"door_panel","enable":true,"match_type":"regex"}
{"panel_code":"^upper_door_(\\d+)$","display_name":"上门$1","category":"door_panel","enable":true,"match_type":"regex"}
{"panel_code":"^door_lower_L_(\\d+)$","display_name":"左柜下门$1","category":"door_panel","enable":true,"match_type":"regex"}
{"panel_code":"^door_upper_L_(\\d+)$","display_name":"左柜上门$1","category":"door_panel","enable":true,"match_type":"regex"}
{"panel_code":"^door_lower_R_(\\d+)$","display_name":"右柜下门$1","category":"door_panel","enable":true,"match_type":"regex"}
{"panel_code":"^door_upper_R_(\\d+)$","display_name":"右柜上门$1","category":"door_panel","enable":true,"match_type":"regex"}

// ============ 书柜: 门板 (三段, 中门为玻璃) ============
